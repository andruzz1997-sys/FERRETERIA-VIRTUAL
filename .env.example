# ========================================
# CONFIGURACIÓN DEL AMBIENTE
# ========================================

# Entorno
NODE_ENV=development

# Puerto
PORT=3000

# Base de Datos (cuando se implemente)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ferreweb
DB_USER=admin
DB_PASSWORD=tu_contraseña_segura

# Clave de API
API_KEY=tu_clave_api_secreta

# Integración de Pagos (Stripe, PayPal, etc.)
STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
PAYPAL_CLIENT_ID=tu_client_id_paypal

# Email (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_app
SMTP_FROM=noreply@ferreweb.com

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000/api

# Seguridad
JWT_SECRET=tu_jwt_secret_key
JWT_EXPIRY=7d

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Social Media
FACEBOOK_URL=https://facebook.com/ferreweb
INSTAGRAM_URL=https://instagram.com/ferreweb
TWITTER_URL=https://twitter.com/ferreweb

# Información de la Empresa
COMPANY_NAME=FerrreWeb
COMPANY_EMAIL=info@ferreweb.com
COMPANY_PHONE=+1 (555) 123-4567
COMPANY_ADDRESS=Calle Principal 123, Ciudad
